{
    "name": "ton-nft-marketplace",
    "version": "0.1.0",
    "description": "",
    "workspaces": [
        "apps/*",
        "libs/*"
    ],
    "private": true,
    "scripts": {
        "dev": "yarn workspaces foreach --recursive --parallel --interlaced --from '{@ton-nft-marketplace/client,@ton-nft-marketplace/api}' run dev",
        "verify": "yarn workspaces foreach -Apt run verify",
        "build": "yarn workspaces foreach -Apt run build",
        "proxy": "dotenv -e .env.secrets.decrypted -- frpc -c frpc.toml",
        "codegen": "graphql-codegen"
    },
    "packageManager": "yarn@4.5.3",
    "devDependencies": {
        "@graphql-codegen/add": "5.0.3",
        "@graphql-codegen/cli": "5.0.3",
        "@graphql-codegen/introspection": "4.0.3",
        "@graphql-codegen/typed-document-node": "5.0.10",
        "@graphql-codegen/typescript": "4.1.0",
        "@graphql-codegen/typescript-operations": "4.3.0",
        "@types/node": "22.7.4",
        "dotenv-cli": "7.4.2",
        "graphql": "16.9.0",
        "ts-node": "10.9.2",
        "typescript": "5.6.2"
    }
}
